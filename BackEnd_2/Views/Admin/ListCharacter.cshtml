@model IEnumerable<Game106_API.Models.Character>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh sách nhân vật";
}

<style>
    /* ── Top bar ── */
    .lc-topbar {
        display: flex; align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .lc-heading { font-size: 20px; font-weight: 700; margin: 0; }
    .lc-sub { font-size: 13px; color: #888; margin: 4px 0 0; }
    .lc-badge {
        background: #EEEDFE; color: #3C3489;
        font-size: 11px; font-weight: 600;
        padding: 4px 10px; border-radius: 20px;
        letter-spacing: 0.5px;
    }
    .lc-btn-add {
        background: #534AB7; color: #fff;
        border: none; border-radius: 8px;
        padding: 9px 18px; font-size: 13px;
        font-weight: 600; cursor: pointer;
        text-decoration: none;
    }
    .lc-btn-add:hover { background: #6358d2; color: #fff; }

    /* ── Search ── */
    .lc-search { margin-bottom: 16px; }
    .lc-search input {
        width: 100%; max-width: 360px;
        padding: 9px 14px;
        border: 1px solid #ddd; border-radius: 8px;
        font-size: 13px; background: #f9f9f9;
        box-sizing: border-box;
    }
    .lc-search input:focus { outline: none; border-color: #7F77DD; }

    /* ── Table ── */
    .lc-table-wrap {
        border: 1px solid #eee;
        border-radius: 12px;
        overflow: hidden;
    }
    .lc-table { width: 100%; border-collapse: collapse; }
    .lc-table thead { background: #f9f9f9; }
    .lc-table thead th {
        padding: 12px 16px;
        font-size: 11px; font-weight: 600;
        color: #888; text-transform: uppercase;
        letter-spacing: 0.6px; text-align: left;
        border-bottom: 1px solid #eee;
    }
    .lc-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: background 0.15s; }
    .lc-table tbody tr:last-child { border-bottom: none; }
    .lc-table tbody tr:hover { background: #fafafa; }
    .lc-table tbody td { padding: 12px 16px; font-size: 13px; vertical-align: middle; }

    /* ── Cells ── */
    .lc-id {
        font-family: monospace; font-size: 12px;
        color: #888; background: #f4f4f4;
        padding: 2px 7px; border-radius: 4px;
    }
    .lc-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        background: linear-gradient(135deg, #534AB7, #7F77DD);
        color: #fff;
        font-size: 12px; font-weight: 700;
        display: inline-flex; align-items: center;
        justify-content: center; margin-right: 10px;
        flex-shrink: 0;
    }
    .lc-name-cell { display: flex; align-items: center; }
    .lc-name-text { font-weight: 600; color: #222; }

    /* ── Level badge ── */
    .lc-level {
        display: inline-block;
        background: #FFF3CD; color: #856404;
        font-size: 11px; font-weight: 700;
        padding: 3px 9px; border-radius: 20px;
        letter-spacing: 0.4px;
    }
    .lc-level.high {
        background: #D1FAE5; color: #065F46;
    }
    .lc-level.low {
        background: #FEE2E2; color: #991B1B;
    }

    /* ── EXP bar ── */
    .lc-exp-wrap { display: flex; align-items: center; gap: 8px; }
    .lc-exp-bar-bg {
        flex: 1; height: 6px; background: #eee;
        border-radius: 99px; overflow: hidden;
        max-width: 80px;
    }
    .lc-exp-bar {
        height: 100%; border-radius: 99px;
        background: linear-gradient(90deg, #534AB7, #a08aff);
        transition: width 0.3s;
    }
    .lc-exp-text { font-size: 12px; color: #555; white-space: nowrap; }

    /* ── Date ── */
    .lc-date { font-size: 12px; color: #888; }

    /* ── Action buttons ── */
    .btn-edit {
        background: #E6F1FB; color: #0C447C;
        border: none; border-radius: 6px;
        padding: 5px 12px; font-size: 12px;
        font-weight: 600; cursor: pointer;
        margin-right: 6px; text-decoration: none;
        display: inline-block;
    }
    .btn-edit:hover { background: #cce1f5; color: #0C447C; }
    .btn-del {
        background: #FCEBEB; color: #791F1F;
        border: none; border-radius: 6px;
        padding: 5px 12px; font-size: 12px;
        font-weight: 600; cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }
    .btn-del:hover { background: #f8d0d0; color: #791F1F; }

    /* ── Footer ── */
    .lc-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }
    .lc-count { font-size: 12px; color: #888; }

    /* ── Empty state ── */
    .lc-empty {
        text-align: center; padding: 48px 20px; color: #aaa;
        font-size: 14px;
    }
    .lc-empty-icon { font-size: 36px; margin-bottom: 8px; }
</style>

<div class="lc-topbar">
    <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
            <span class="lc-heading">⚔️ Nhân vật</span>
            <span class="lc-badge">@Model.Count() nhân vật</span>
        </div>
        <div class="lc-sub">Quản lý toàn bộ nhân vật trong hệ thống</div>
    </div>
    <a href="/admin/characters/create" class="lc-btn-add">+ Thêm nhân vật</a>
</div>

<div class="lc-search">
    <input type="text" id="searchInput" placeholder="Tìm kiếm theo tên nhân vật..." />
</div>

<div class="lc-table-wrap">
    <table class="lc-table" id="characterTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nhân vật</th>
                <th>Account ID</th>
                <th>Level</th>
                <th>EXP</th>
                <th>Ngày tạo</th>
                <th>Cập nhật</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="lc-empty">
                            <div class="lc-empty-icon">🗡️</div>
                            Chưa có nhân vật nào trong hệ thống.
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var initials = string.IsNullOrEmpty(item.Name) ? "?"
                        : item.Name.Length >= 2
                            ? item.Name.Substring(0, 2).ToUpper()
                            : item.Name.ToUpper();

                    // Level badge class
                    var levelClass = item.Level >= 50 ? "high" : item.Level < 10 ? "low" : "";

                    // EXP bar width — cap tại 100%
                    var expMax = 10000;
                    var expPercent = Math.Min((item.Exp * 100) / expMax, 100);

                    <tr>
                        <td><span class="lc-id">#@item.Id</span></td>

                        <td>
                            <div class="lc-name-cell">
                                <span class="lc-avatar">@initials</span>
                                <span class="lc-name-text">@(item.Name ?? "Không tên")</span>
                            </div>
                        </td>

                        <td><span class="lc-id">@item.Account_id</span></td>

                        <td>
                            <span class="lc-level @levelClass">Lv.@item.Level</span>
                        </td>

                        <td>
                            <div class="lc-exp-wrap">
                                <div class="lc-exp-bar-bg">
                                    <div class="lc-exp-bar" style="width:@expPercent%"></div>
                                </div>
                                <span class="lc-exp-text">@item.Exp</span>
                            </div>
                        </td>

                        <td><span class="lc-date">@item.Created_at.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="lc-date">@item.Updated_at.ToString("dd/MM/yyyy")</span></td>

                        <td>
                            <a href="/admin/characters/edit/@item.Id" class="btn-edit">Sửa</a>
                            <a href="/admin/characters/delete/@item.Id" class="btn-del"
                               onclick="return confirm('Bạn có chắc muốn xóa nhân vật @Html.Raw(item.Name ?? "này")?')">Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="lc-footer">
    <span class="lc-count" id="countLabel">Hiển thị @Model.Count() nhân vật</span>
</div>

<script>
    // Live search filter
    const searchInput = document.getElementById('searchInput');
    const tableBody = document.querySelector('#characterTable tbody');
    const countLabel = document.getElementById('countLabel');

    searchInput.addEventListener('input', function () {
        const keyword = this.value.toLowerCase().trim();
        const rows = tableBody.querySelectorAll('tr');
        let visible = 0;

        rows.forEach(row => {
            // Tìm trong cột tên (td thứ 2)
            const nameCell = row.querySelector('td:nth-child(2)');
            if (!nameCell) return; // empty state row

            const text = nameCell.textContent.toLowerCase();
            const match = keyword === '' || text.includes(keyword);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        countLabel.textContent = keyword
            ? `Hiển thị ${visible} nhân vật (lọc từ "@{}" tổng)`
                .replace('@{}', '@Model.Count()')
            : `Hiển thị @Model.Count() nhân vật`;
    });
</script>
