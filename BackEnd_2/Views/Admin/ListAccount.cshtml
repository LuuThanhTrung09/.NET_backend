@model IEnumerable<Game106_API.Models.Account>

@{
    Layout = "_Layout";
}

<style>
    .la-topbar {
        display: flex; align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .la-heading { font-size: 20px; font-weight: 700; margin: 0; }
    .la-sub { font-size: 13px; color: #888; margin: 4px 0 0; }
    .la-badge {
        background: #EEEDFE; color: #3C3489;
        font-size: 11px; font-weight: 600;
        padding: 4px 10px; border-radius: 20px;
        letter-spacing: 0.5px;
    }
    .la-btn-add {
        background: #534AB7; color: #fff;
        border: none; border-radius: 8px;
        padding: 9px 18px; font-size: 13px;
        font-weight: 600; cursor: pointer;
        text-decoration: none;
    }
    .la-btn-add:hover { background: #6358d2; color: #fff; }
    .la-search {
        margin-bottom: 16px;
    }
    .la-search input {
        width: 100%; max-width: 360px;
        padding: 9px 14px;
        border: 1px solid #ddd; border-radius: 8px;
        font-size: 13px; background: #f9f9f9;
        box-sizing: border-box;
    }
    .la-search input:focus { outline: none; border-color: #7F77DD; }
    .la-table-wrap {
        border: 1px solid #eee;
        border-radius: 12px;
        overflow: hidden;
    }
    .la-table { width: 100%; border-collapse: collapse; }
    .la-table thead { background: #f9f9f9; }
    .la-table thead th {
        padding: 12px 16px;
        font-size: 11px; font-weight: 600;
        color: #888; text-transform: uppercase;
        letter-spacing: 0.6px; text-align: left;
        border-bottom: 1px solid #eee;
    }
    .la-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: background 0.15s; }
    .la-table tbody tr:last-child { border-bottom: none; }
    .la-table tbody tr:hover { background: #fafafa; }
    .la-table tbody td { padding: 12px 16px; font-size: 13px; vertical-align: middle; }
    .la-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        background: #EEEDFE; color: #534AB7;
        font-size: 12px; font-weight: 700;
        display: inline-flex; align-items: center;
        justify-content: center; margin-right: 10px;
    }
    .la-id {
        font-family: monospace; font-size: 12px;
        color: #888; background: #f4f4f4;
        padding: 2px 7px; border-radius: 4px;
    }
    .la-email { color: #888; }
    .btn-edit {
        background: #E6F1FB; color: #0C447C;
        border: none; border-radius: 6px;
        padding: 5px 12px; font-size: 12px;
        font-weight: 600; cursor: pointer;
        margin-right: 6px; text-decoration: none;
    }
    .btn-del {
        background: #FCEBEB; color: #791F1F;
        border: none; border-radius: 6px;
        padding: 5px 12px; font-size: 12px;
        font-weight: 600; cursor: pointer;
        text-decoration: none;
    }
    .la-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }
    .la-count { font-size: 12px; color: #888; }
</style>

@*Fix lỗi cũ: </h2> → <h2>, và ViewData[index:] → ViewData[] *@
<h2>@ViewBag.Name</h2>
<h5>@ViewData["Address"]</h5>

<div class="la-topbar">
    <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
            <span class="la-heading">Tài khoản người chơi</span>
            <span class="la-badge">@Model.Count() tài khoản</span>
        </div>
        <div class="la-sub">Quản lý toàn bộ tài khoản trong hệ thống</div>
    </div>
    <a href="/admin/register" class="la-btn-add">+ Thêm mới</a>
</div>

<div class="la-search">
    <input type="text" placeholder="Tìm kiếm theo tên hoặc email..." />
</div>

<div class="la-table-wrap">
    <table class="la-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Người dùng</th>
                <th>Email</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var initials = string.IsNullOrEmpty(item.Name) ? "?" 
                    : item.Name.Length >= 2 
                        ? item.Name.Substring(0,2).ToUpper() 
                        : item.Name.ToUpper();
                <tr>
                    <td><span class="la-id">#@item.Id</span></td>
                    <td>
                        <span class="la-avatar">@initials</span>
                        @item.Name
                    </td>
                    <td><span class="la-email">@item.Email</span></td>
                    <td>@item.Created_at.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a href="#" class="btn-edit">Sửa</a>
                        <a href="#" class="btn-del">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="la-footer">
    <span class="la-count">Hiển thị @Model.Count() tài khoản</span>
</div>